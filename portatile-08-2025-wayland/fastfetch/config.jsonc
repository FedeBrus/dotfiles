{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/haida/.config/fastfetch/fox.txt",
        "color": {"1": "38;5;214"},
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": "| ",
        "color": {
            "separator": "white"
        },
        "constants": [
            "────────────────────────────────────────",
            "│\u001b[40C│\u001b[40D"
        ]
    },
    "modules": [
        {
            "format": "{#39}{#1}╭{$1}╮\u001b[76D {user-name}{at-symbol-colored}{host-name} ",
            "type": "title"
        },
        {
            "key": "{#39}{$2}{#91} Kernel   ",
            "type": "kernel"
        },
        {
            "key": "{#39}{$2}{#92} Distro   ",
            "type": "os"
        },
        {
            "key": "{#39}{$2}{#93} Packages ",
            "type": "packages"
        },
        {
            "key": "{#39}{$2}{#94} Uptime   ",
            "type": "uptime"
        },
        {
            "key": "{#39}{$2}{#95} WM       ",
            "type": "wm"
        },
        {
            "key": "{#39}{$2}{#96} Term     ",
            "type": "terminal"
        },
        {
            "key": "{#39}{$2}{#97} Shell    ",
            "type": "shell"
        },
        {
            "format": "{#39}╰{$1}╯",
            "type": "custom"
        }
    ]
}
