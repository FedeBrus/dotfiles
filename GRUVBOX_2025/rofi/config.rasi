configuration {
 	modes: "window,drun";
	font: "IosevkaNerdFont 12";
 	show-icons: true;
  terminal: "/usr/bin/alacritty";
	icon-theme: "Papirus";
    drun-display-format: "{name} {category}";

    timeout {
        action: "kb-cancel";
        delay:  0;
    }

    filebrowser {
        directories-first: true;
        sorting-method: "name";
    }

    drun {
        display-name: " ";
    }

    run {
        display-name: " ";
    }

    window {
        display-name: " ";
    }
}

@theme "./themes/gruvbox-dark.rasi"
